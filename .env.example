# Copy to .env. Never commit .env.
NC_ENV=dev
# postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres  (Supabase: use the session pooler host)
NC_DATABASE_URL=
NC_DB_SCHEMA=notchcount
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NC_SESSION_SECRET=
NC_BLOB_SIGNING_SECRET=
NC_PUBLIC_BASE_URL=http://localhost:8000

# Agentboxd filing (optional until P5): draft key = drafts:read + drafts:write; send key adds messages:send
NC_AGENTBOXD_DRAFT_KEY=
NC_AGENTBOXD_SEND_KEY=
NC_AGENTBOXD_WEBHOOK_SECRET=

# MojoAuth: with a key set, the sign-in screen also offers email codes (invite links keep working)
NC_AUTH_PROVIDER=invite
NC_MOJOAUTH_API_KEY=

# Worker
NC_MODEL_DIR=models/cache
NC_EMBEDDER=dinov2_vits14_int8
NC_MODEL_THREADS=2
